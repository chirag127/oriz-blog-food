---
/*
 * Footer — KITCHEN PASS (recipe-card-grid archetype).
 *
 * Not the 4-column sibling link farm. A single pass counter: the z-strike
 * brand + a service line, one inline "order rail" of desks + feeds set as mono
 * chips, and the legal strip. Reads like the bottom of a menu, not a sitemap.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import { getCategoriesWithCounts, slugifyTag } from '~/lib/blog'

const desks = (await getCategoriesWithCounts()).slice(0, 8).map(({ category, count }) => ({
  name: category,
  slug: slugifyTag(category),
  count,
}))
---
<footer class="pass" role="contentinfo">
  <div class="pass-inner">
    <div class="pass-head">
      <p class="pass-brand">
        <span class="pb-mark">ori<span class="pb-z">z</span></span>
        <span class="pb-sep" aria-hidden="true">/</span>
        <span class="pb-sub">kitchen</span>
      </p>
      <p class="pass-line">Cook the thing you&apos;d order takeaway for.</p>
    </div>

    <nav class="order-rail" aria-label="Browse recipes by desk">
      <a class="rail-chip rail-all" href="/blog/">All recipes</a>
      {desks.map((d) => (
        <a class="rail-chip" href={`/categories/${d.slug}/`}>{d.name}<span class="rail-n">{d.count}</span></a>
      ))}
      <a class="rail-chip rail-feed" href="/rss.xml">RSS</a>
      <a class="rail-chip rail-feed" href="/series/">Series</a>
    </nav>
  </div>

  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-food"
    appName="The Test Kitchen Ledger"
    bio="Recipes tested on a real weeknight — Indian and global home cooking — by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .pass {
    margin-top: 5rem;
    background: var(--paper-2);
    color: var(--ink);
    border-top: 2px solid var(--ink);
  }
  .pass-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 1.5rem;
  }
  .pass-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .pass-brand {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .pb-z { position: relative; color: var(--accent); }
  .pb-sep { margin-inline: 0.15em; color: var(--ink-mute); font-weight: 400; }
  .pb-sub { font-family: var(--font-mono); font-size: 0.7em; color: var(--accent); letter-spacing: 0.02em; }
  .pass-line {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--ink-mute);
    max-width: 44ch;
  }

  .order-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 1.25rem;
  }
  .rail-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-decoration: none;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    transition: color var(--dur-fast, 120ms) ease, border-color var(--dur-fast, 120ms) ease;
  }
  .rail-chip:hover { color: var(--ink); border-color: var(--accent); }
  .rail-n { color: var(--accent); font-size: 10px; }
  .rail-all { color: var(--ink); border-color: var(--rule-strong, var(--rule)); }
  .rail-feed { color: var(--accent); }
  .rail-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
