---
/**
 * KitchenTicker — SIGNATURE COMPONENT (food blog only).
 *
 * A horizontal auto-scrolling ticker strip that surfaces recipe metadata
 * from the latest posts: prep-time signal, difficulty dot, and cuisine tag.
 * Reads like the order-in notation at the top of a chef's pass ticket.
 *
 * Pure CSS animation — no JS required. Reduced-motion: static list.
 * The <noscript> fallback is automatic because the animation is CSS-only.
 *
 * Usage: place inside a page layout above the main card grid.
 */
import type { CollectionEntry } from 'astro:content'

export interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props

// Build ticker entries from the 12 newest posts.
const entries = posts.slice(0, 12).map((p, i) => {
  const rt = p.data.readingTime ?? ''
  const cat = p.data.category ?? ''
  // Derive a difficulty signal from reading time (proxy for recipe complexity).
  const mins = parseInt(rt)
  const diff = Number.isFinite(mins) && mins <= 4 ? 'Quick' : Number.isFinite(mins) && mins <= 7 ? 'Easy' : 'Weekend'
  return { id: i, title: p.data.title, rt, cat, diff }
})

// Duplicate for seamless infinite scroll (CSS trick: two identical lists).
const doubled = [...entries, ...entries]
---

<div class="ticker-wrap" aria-label="Recent recipe signals" role="marquee">
  <ul class="ticker-track" aria-hidden="true">
    {doubled.map((e, i) => (
      <li class="ticker-item" key={i}>
        <span class="t-sep" aria-hidden="true">◆</span>
        <span class="t-diff" data-diff={e.diff.toLowerCase()}>{e.diff}</span>
        <span class="t-title">{e.title}</span>
        {e.cat && <span class="t-cat">{e.cat}</span>}
        {e.rt && <span class="t-rt">{e.rt}</span>}
      </li>
    ))}
  </ul>
  {/* Accessible static fallback inside a visually-hidden list */}
  <ul class="ticker-sr">
    {entries.map((e) => (
      <li>{e.title} — {e.diff}{e.cat ? `, ${e.cat}` : ''}</li>
    ))}
  </ul>
</div>

<style>
  .ticker-wrap {
    overflow: hidden;
    white-space: nowrap;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding-block: 0.5rem;
    background: color-mix(in oklab, var(--paper-2) 70%, transparent);
    position: relative;
  }

  .ticker-track {
    display: inline-flex;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    /* Two copies: first completes then immediately the second starts (same content). */
    animation: ticker-scroll 42s linear infinite;
  }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 1.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    white-space: nowrap;
  }

  .t-sep {
    color: var(--rule-strong, var(--rule));
    font-size: 8px;
    flex-shrink: 0;
  }

  .t-diff {
    font-weight: 600;
    font-size: 10px;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    letter-spacing: 0.12em;
  }
  .t-diff[data-diff='quick']   { background: color-mix(in oklab, var(--v-health) 18%, transparent); color: var(--v-health); }
  .t-diff[data-diff='easy']    { background: color-mix(in oklab, var(--v-culture) 18%, transparent); color: var(--v-culture); }
  .t-diff[data-diff='weekend'] { background: color-mix(in oklab, var(--v-finance) 18%, transparent); color: var(--v-finance); }

  .t-title {
    color: var(--ink);
    font-weight: 500;
    max-width: 28ch;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 12px;
  }

  .t-cat {
    color: var(--accent);
    letter-spacing: 0.08em;
  }

  .t-rt {
    color: var(--ink-mute);
    font-size: 10px;
    border-left: 1px solid var(--rule);
    padding-left: 0.45rem;
  }

  /* Screen-reader only text */
  .ticker-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }
</style>
