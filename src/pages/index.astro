---
import KitchenTicker from '~/components/KitchenTicker.astro'
import PostCard from '~/components/blog/PostCard.astro'
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — oriz-blog-food homepage (recipe-card-grid archetype).
 *
 * The board masthead + category chip rail live in <Header>. This page is the
 * MENU CANVAS below the board: a lead "on the pass" dish spanning full width,
 * then the rest of the recipes as tall cards in an asymmetric CSS-columns
 * masonry (heights vary with dek length). A slim "cooking through" series rail
 * sits between. Sidebar-free, card-first — no ledger rows, no top-nav grid.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  slugifyTag,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const rest = allPosts.slice(1)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total,
    published: count,
    current: count,
    latest,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="The Test Kitchen Ledger"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="container-page menu">
    {/* Kitchen ticker — scrolling recipe-signal strip, food blog signature */}
    {allPosts.length > 0 && (
      <div class="ticker-rail">
        <KitchenTicker posts={allPosts} />
      </div>
    )}

    {inProgress.length > 0 && (
      <section class="passline" aria-labelledby="passline-h">
        <h2 id="passline-h" class="passline-h mono">Cooking through</h2>
        <ul class="passline-list">
          {inProgress.map((s) => (
            <li>
              <a class="passline-link" href={`/series/${s.slug}/`}>
                <span class="passline-name">{s.name}</span>
                <SeriesSpine total={s.total} published={s.published} current={s.current} size="sm" />
                <span class="passline-meta mono">{s.published}/{s.total}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="board-of-fare" aria-label="Recipes">
      <h2 class="fare-h mono">Today&apos;s board of fare</h2>
      {allPosts.length === 0 ? (
        <p class="fare-empty">First recipe drops shortly. Kitchen&apos;s warming up.</p>
      ) : (
        <>
          {lead && (
            <div class="fare-lead">
              <PostCard post={lead} feature />
            </div>
          )}
          {rest.length > 0 && (
            <div class="fare-masonry">
              {rest.map((p) => <PostCard post={p} />)}
            </div>
          )}
        </>
      )}
      <p class="fare-all">
        <a href="/archive/">Every recipe in the index →</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .container-page.menu {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 0;
  }

  /* Kitchen ticker rail — bleed edge-to-edge inside the container. */
  .ticker-rail {
    margin-inline: calc(clamp(1.25rem, 4vw, 2rem) * -1);
    margin-bottom: 1.75rem;
  }

  /* ── Series pass line ─────────────────────────────────────────────── */
  .passline { margin-bottom: 2rem; }
  .passline-h,
  .fare-h {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-mute);
    font-weight: 500;
    margin: 0 0 1rem;
  }
  .passline-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .passline-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    border: 1px dashed var(--rule);
    border-radius: var(--radius-button, 7px);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) ease;
  }
  .passline-link:hover { border-color: var(--accent); }
  .passline-link:hover .passline-name { color: var(--accent); }
  .passline-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .passline-meta { font-size: 11px; color: var(--ink-mute); letter-spacing: 0.06em; }

  /* ── Board of fare — lead dish + masonry ──────────────────────────── */
  .board-of-fare { padding-bottom: 3rem; }
  .fare-lead { margin-bottom: 1rem; }

  /* Asymmetric masonry via CSS columns — heights vary with content. */
  .fare-masonry {
    column-gap: 1rem;
    columns: 1;
  }
  .fare-masonry > :global(.dish) { margin-bottom: 1rem; }
  @media (min-width: 600px) { .fare-masonry { columns: 2; } }
  @media (min-width: 1000px) { .fare-masonry { columns: 3; } }

  .fare-empty {
    color: var(--ink-mute);
    font-family: var(--font-display);
    font-size: 1.0625rem;
  }
  .fare-all {
    margin: 1.75rem 0 0;
    font-family: var(--font-sans);
    font-size: 13.6px;
  }
  .fare-all a {
    color: var(--ink-mute);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule);
  }
  .fare-all a:hover { color: var(--accent); text-decoration-color: var(--accent); }
</style>
